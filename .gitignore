# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Cached API data (regenerable, not source) - ignore everything under data/
# except the one file explicitly un-ignored below.
data/*

# Squad state and the prediction log ARE committed (exceptions to the rule
# above) - real accumulated state that should persist and be backed up, not
# regenerable cache. The prediction log specifically is the "get smarter
# every gameweek" memory (see fpl/prediction_log.py) - losing it would mean
# losing the accumulated real-world validation data.
!data/my_squad.json
!data/prediction_log.jsonl
